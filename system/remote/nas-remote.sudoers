# The web remote (nas-remote, user nasremote) may run exactly these commands
# as root, nothing else. Every button in buttons.toml must fit one of them.
# Installed as /etc/sudoers.d/nas-remote (0440).
Defaults:nasremote !requiretty, env_keep += "DEBIAN_FRONTEND RESTIC_PROGRESS_FPS"

Cmnd_Alias NR_DOCKER = /usr/bin/docker ps -a --format *, /usr/bin/docker inspect -f *, \
                       /usr/bin/docker logs --tail 60 *, /usr/bin/docker restart *, \
                       /usr/bin/docker start *, /usr/bin/docker stop *, /usr/bin/docker image prune -f, \
                       /usr/bin/docker image prune -f -a, /usr/bin/docker system df, \
                       /usr/bin/docker logs --tail 5000 gluetun
Cmnd_Alias NR_DISKS  = /usr/sbin/smartctl -i -H -A /dev/sd?, /usr/sbin/smartctl -i -H -A /dev/nvme?n?
Cmnd_Alias NR_UPDATE = /usr/sbin/omv-compose-update *, /usr/sbin/omv-upgrade
Cmnd_Alias NR_APT    = /usr/bin/apt-get update -q, /usr/bin/apt-get -s autoremove, \
                       /usr/bin/apt-get -y autoremove, /usr/bin/apt-get clean
Cmnd_Alias NR_SYS    = /usr/bin/systemctl reboot, /usr/bin/systemctl restart tailscaled, \
                       /usr/bin/systemctl restart claude-remote, \
                       /usr/local/sbin/claude-elevate off, /usr/local/sbin/claude-elevate status, \
                       /usr/bin/journalctl -t claude-elevate -n 30 -o short-iso --no-pager

# Backups: start the nightly units early, read their log (and follow one while it runs), and backup-verify's
# read-only checks (no check-data for r2).
Cmnd_Alias NR_BACKUP = /usr/bin/systemctl start --no-block r2-backup, /usr/bin/systemctl start --no-block usb-backup, \
                       /usr/bin/journalctl -u r2-backup -u usb-backup -n 40 -o short-iso --no-pager, \
                       /usr/bin/journalctl -u r2-backup -n 15 -o cat --no-pager, \
                       /usr/bin/journalctl -u usb-backup -n 15 -o cat --no-pager, \
                       /usr/local/sbin/backup-verify usb snapshots, /usr/local/sbin/backup-verify usb check, \
                       /usr/local/sbin/backup-verify usb check-data, /usr/local/sbin/backup-verify local snapshots, \
                       /usr/local/sbin/backup-verify local check, /usr/local/sbin/backup-verify local check-data, \
                       /usr/local/sbin/backup-verify r2 snapshots, /usr/local/sbin/backup-verify r2 check

# Grants the web remote may give. Full also needs the remote's own Face ID check
# (a passkey it verifies itself, on top of the Authelia login).
Cmnd_Alias NR_GRANT  = /usr/local/sbin/claude-elevate 10 read, /usr/local/sbin/claude-elevate 15 read, \
                       /usr/local/sbin/claude-elevate 30 read, /usr/local/sbin/claude-elevate 60 read, \
                       /usr/local/sbin/claude-elevate 10 docker, /usr/local/sbin/claude-elevate 15 docker, \
                       /usr/local/sbin/claude-elevate 30 docker, /usr/local/sbin/claude-elevate 60 docker, \
                       /usr/local/sbin/claude-elevate 10 packages, /usr/local/sbin/claude-elevate 15 packages, \
                       /usr/local/sbin/claude-elevate 30 packages, /usr/local/sbin/claude-elevate 60 packages, \
                       /usr/local/sbin/claude-elevate 10 disks, /usr/local/sbin/claude-elevate 15 disks, \
                       /usr/local/sbin/claude-elevate 30 disks, /usr/local/sbin/claude-elevate 60 disks, \
                       /usr/local/sbin/claude-elevate 15 full, /usr/local/sbin/claude-elevate 30 full
Cmnd_Alias NR_AUDIT  = /usr/local/sbin/claude-audit --accept
Cmnd_Alias NR_DRIVE  = /usr/local/sbin/nas-drive status, /usr/local/sbin/nas-drive mount, /usr/local/sbin/nas-drive eject, \
                      /usr/local/sbin/nas-drive mount /dev/sd[a-z], /usr/local/sbin/nas-drive mount /dev/sd[a-z][0-9], \
                      /usr/local/sbin/nas-drive mount /dev/sd[a-z][0-9][0-9], /usr/local/sbin/nas-drive eject /dev/sd[a-z], \
                      /usr/local/sbin/nas-drive eject /dev/sd[a-z][0-9], /usr/local/sbin/nas-drive eject /dev/sd[a-z][0-9][0-9]
Cmnd_Alias NR_STEAM  = /usr/local/sbin/steam-mode stream, /usr/local/sbin/steam-mode monitor
# Update app: show the diff, then (after the remote's Face ID check) install exactly that copy.
Cmnd_Alias NR_SELF   = /usr/local/sbin/nas-remote-update --stage, /usr/local/sbin/nas-remote-update --apply *

nasremote ALL=(root) NOPASSWD: NR_DOCKER, NR_DISKS, NR_UPDATE, NR_APT, NR_SYS, NR_BACKUP, NR_GRANT, NR_AUDIT, NR_STEAM, NR_DRIVE, NR_SELF

# Claude remote › Show screen: read (never type into) Remote Control's tmux window, as claude.
nasremote ALL=(claude) NOPASSWD: /usr/bin/tmux capture-pane -p -J -t claude
