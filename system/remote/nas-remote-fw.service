# Keeps the claude user off the web remote's localhost port. The remote trusts
# the Remote-User header Caddy sets after the passkey login; anything on this
# machine that could reach 127.0.0.1:8765 directly could fake that header.
# Installed as /etc/systemd/system/nas-remote-fw.service. claude-audit checks
# the rule is in place.
[Unit]
Description=Block claude from the nas web remote's port
Before=nas-remote.service
After=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'iptables -C OUTPUT -o lo -p tcp --dport 8765 -m owner --uid-owner claude -j REJECT 2>/dev/null || iptables -I OUTPUT 1 -o lo -p tcp --dport 8765 -m owner --uid-owner claude -j REJECT'

[Install]
WantedBy=multi-user.target
